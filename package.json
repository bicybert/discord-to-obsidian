{
	"name": "discord-to-obsidian",
	"version": "0.1.0",
	"description": "Sync Discord channel messages into your vault as markdown notes",
	"main": "build/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release": "node scripts/bump.mjs"
	},
	"keywords": [
		"obsidian",
		"discord"
	],
	"author": "bicybert",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^5.7.0"
	}
}
